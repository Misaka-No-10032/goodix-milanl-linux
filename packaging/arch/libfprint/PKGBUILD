# Local replacement package; stage the named project files beside this PKGBUILD.
pkgname=libfprint-goodix-milanl
pkgver=1.94.100
pkgrel=1
pkgdesc='Fingerprint reader library with the default driver set and Goodix MilanL support'
arch=('x86_64')
url='https://fprint.freedesktop.org/'
license=('LGPL-2.1-or-later' 'GPL-2.0-only')
depends=('libgcc' 'glib2' 'glibc' 'libgudev' 'libgusb' 'openssl' 'pixman')
makedepends=('git' 'glib2-devel' 'gobject-introspection' 'meson' 'ninja' 'python-cairo' 'python-gobject' 'systemd')
provides=("libfprint=$pkgver" 'libfprint-2.so')
conflicts=('libfprint')
options=('!debug')
_commit=6f9479c3d55f847c1b3769f28ceb99227f9858cf
source=("git+https://gitlab.freedesktop.org/libfprint/libfprint.git#commit=$_commit"
        '0001-register-goodix_milanl-driver.patch' 'goodix_milanl.c' 'goodix_milanl_proto.h'
        'LICENSE.goodix-milanl')
sha256sums=('SKIP'
            '8da29e27caee584085d9fd96d8f8283717d4c7a01123c3140080f9cf1938a8cc'
            '42f156d7d6e2ecc31ce104e53a472aac3d7b70f2658ab4b9ab14c2a857601837'
            '3b82ace72ffc415eb0dd8ef0288c39663f4ad57d6a94bf27d9542efdb14afed5'
            'aaf135472f81c5b4a0dca9367e5bb5e9750032b5bebe5442b36e4c0a47430df3')

prepare() {
    patch -d libfprint -p1 < 0001-register-goodix_milanl-driver.patch
    cp goodix_milanl.c goodix_milanl_proto.h libfprint/libfprint/drivers/
}

build() {
    "${MESON:-meson}" setup build libfprint \
        --prefix=/usr --libdir=lib --libexecdir=lib \
        --sysconfdir=/etc --localstatedir=/var \
        --buildtype=release --wrap-mode=nodownload \
        -Ddrivers=default -Dintrospection=true -Ddoc=false \
        -Dgtk-examples=false -Dinstalled-tests=false
    "${MESON:-meson}" compile -C build
}

check() {
    "${MESON:-meson}" test -C build --print-errorlogs
}

package() {
    DESTDIR="$pkgdir" "${MESON:-meson}" install -C build --no-rebuild
    install -Dm644 LICENSE.goodix-milanl \
        "$pkgdir/usr/share/licenses/$pkgname/LICENSE.goodix-milanl"
}
